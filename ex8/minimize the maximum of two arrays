class Solution {
    private long gcd(long a, long b) {
        while (b != 0) {
            long temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }
    private long lcm(long a, long b) {
        return (a * b) / gcd(a, b);
    }
    private boolean check(long x, long d1, long d2, long c1, long c2, long lcmVal) {
        long cnt1 = x - x / d1;
        long cnt2 = x - x / d2;
        long cntBoth = x - x / lcmVal;
        return cnt1 >= c1 && cnt2 >= c2 && cntBoth >= (c1 + c2);
    }

    public int minimizeSet(int divisor1, int divisor2, int uniqueCnt1, int uniqueCnt2) {
        long d1 = divisor1;
        long d2 = divisor2;
        long lcmVal = lcm(d1, d2);
        
        long low = 1;
        long high = 2000000007L; 
        long ans = high;

        while (low <= high) {
            long mid = low + (high - low) / 2;

            if (check(mid, d1, d2, uniqueCnt1, uniqueCnt2, lcmVal)) {
                ans = mid;
                high = mid - 1;
            } else {
                low = mid + 1;  /
            }
        }

        return (int) ans;
    }
}
