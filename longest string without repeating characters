class Solution:
    def lengthOfLongestSubstring(self, s: str) -> int:
        maxlength = 0
        left = 0
        charmap = {}
        for right in range(len(s)):
            if s[right] in charmap and charmap[s[right]] >= left:
                left = charmap[s[right]] + 1
            charmap[s[right]] = right
            maxlength = max(maxlength, right - left + 1)
        return maxlength


